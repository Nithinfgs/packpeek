{
  "name": "packpeek",
  "version": "0.1.0",
  "description": "See what you are about to publish. Inspects the real npm tarball, wheel, sdist, crate or directory for source maps, secrets, .env files, local paths and size regressions.",
  "keywords": [
    "npm",
    "publish",
    "sourcemap",
    "secrets",
    "supply-chain",
    "security",
    "cli",
    "wheel",
    "tarball",
    "devtools"
  ],
  "license": "MIT",
  "author": "Nithinfgs",
  "homepage": "https://github.com/Nithinfgs/packpeek#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nithinfgs/packpeek.git"
  },
  "bugs": {
    "url": "https://github.com/Nithinfgs/packpeek/issues"
  },
  "type": "module",
  "bin": {
    "packpeek": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "demo": "node dist/src/cli.js demo",
    "demo:svg": "npm run build && node scripts/render-demo-svg.mjs",
    "self-check": "node dist/src/cli.js --fail-on medium",
    "prepublishOnly": "npm run lint && npm test && npm run self-check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1"
  }
}
